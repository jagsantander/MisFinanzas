# ─────────────── MisFinanzas · variables de entorno (sin secretos) ───────────────
# Copia a .env.local (desarrollo) o configúralas en tu plataforma. NUNCA subas valores reales al repositorio.

# URL pública de la app (OAuth redirect, enlaces de correo, WebAuthn origin)
APP_URL=http://localhost:3000
# Opcional: RP ID de WebAuthn (por defecto, el hostname de APP_URL)
# WEBAUTHN_RP_ID=localhost

# Postgres (en desarrollo: `npm run db:local` levanta uno en el puerto 5433)
DATABASE_URL=postgres://misfinanzas:misfinanzas_local@localhost:5433/misfinanzas

# Cifrado de credenciales (AES-256-GCM). Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
# Rotación: deja la clave anterior aquí como "id:base64" mientras re-cifras
# ENCRYPTION_KEY_PREVIOUS=
# Secreto para seudonimizar IP en el control de intentos (32+ bytes aleatorios)
SESSION_SECRET=

# Si el servidor está detrás de un proxy de confianza (para leer X-Forwarded-For)
TRUST_PROXY=0

# Correo transaccional (verificación, recuperación, avisos). Sin esto, en desarrollo se usa /dev-outbox
# SMTP_URL=smtps://usuario:clave@smtp.proveedor.com:465
# MAIL_FROM="MisFinanzas <no-reply@tudominio.cl>"

# Gmail (Google Cloud Console → OAuth client "Web application")
# Redirect URI autorizado: ${APP_URL}/api/connections/mail/callback  · Scope: gmail.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Outlook (Microsoft Entra ID → App registrations)
# Redirect URI (Web): ${APP_URL}/api/connections/mail/callback · Permisos delegados: offline_access, User.Read, Mail.Read
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Web Push (VAPID). Genera con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tudominio.cl

# Worker
WORKER_CONCURRENCY=3
DB_POOL_MAX=10

# Precios estimados de IA (USD por millón de tokens) para mostrar costos aproximados
# AI_PRICING_JSON={"mi-modelo":{"in":1.0,"out":4.0}}

# App Android (Trusted Web Activity). Valores que imprime android/build-apk.sh
ANDROID_PACKAGE_NAME=cl.misfinanzas.app
# Huella SHA-256 del certificado de firma (separa varias con coma)
ANDROID_CERT_SHA256=

<?xml version="1.0" encoding="utf-8"?>
<!-- Solo HTTPS y solo CA del sistema (no confía en certificados instalados por el usuario). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

{
  "name": "misfinanzas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/copy-apps-script.mjs && next dev",
    "build": "node scripts/copy-apps-script.mjs && next build && node scripts/postbuild-csp.mjs out",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/MisFinanzas npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "luxon": "^3.7.2",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
